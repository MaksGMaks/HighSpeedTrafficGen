   <item>
    <layout class="QVBoxLayout" name="rightVLayout">
     <item>
      <widget class="QStackedWidget" name="contentStack">

       <!-- Page 0: Getting Started -->
       <widget class="QWidget" name="pageGettingStarted">
        <layout class="QVBoxLayout">
         <item>
          <widget class="QLabel" name="labelGSTitle">
           <property name="text"><string>&lt;h2&gt;Getting Started&lt;/h2&gt;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QTextBrowser" name="browserGS">
           <property name="openExternalLinks"><bool>true</bool></property>
           <property name="html">
            <string>&lt;!DOCTYPE html&gt;
             &lt;html&gt;
             &lt;body style="font-family: 'Times New Roman', serif; font-size: 13px;"&gt;

             &lt;h3&gt;1. Connect to a Server&lt;/h3&gt;
             &lt;p&gt;When the application launches, the &lt;b&gt;Server Selection&lt;/b&gt; dialog appears automatically.
             Use it to connect the generator to a network interface or a remote agent:&lt;/p&gt;
             &lt;ul&gt;
             &lt;li&gt;&lt;b&gt;IP Address&lt;/b&gt; — enter the target server IP (e.g. &lt;code&gt;192.168.1.10&lt;/code&gt;).
             The field accepts only valid IPv4 addresses (max 15 characters).
             Default placeholder shows &lt;code&gt;127.0.0.1&lt;/code&gt; (localhost).&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Port (dropdown)&lt;/b&gt; — select a discovered port from the list.
             Click &lt;b&gt;Search&lt;/b&gt; first to populate this list with available services.&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Direct connection&lt;/b&gt; — enable this checkbox to enter a port number manually
             instead of using auto-discovery. The &lt;b&gt;Port&lt;/b&gt; text field becomes active;
             enter up to 5 characters (e.g. &lt;code&gt;12345&lt;/code&gt;).&lt;/li&gt;
             &lt;li&gt;Click &lt;b&gt;Search&lt;/b&gt; to scan for available agents on the given IP,
             then click &lt;b&gt;Connect&lt;/b&gt; to establish the connection.&lt;/li&gt;
             &lt;/ul&gt;

             &lt;h3&gt;2. Main Window Layout&lt;/h3&gt;
             &lt;p&gt;After connecting you will see the main window with a menu bar at the top:&lt;/p&gt;
             &lt;ul&gt;
             &lt;li&gt;&lt;b&gt;File&lt;/b&gt; — open or save PCAP files.&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Settings → Theme&lt;/b&gt; — switch between &lt;i&gt;Dark&lt;/i&gt; and &lt;i&gt;Light&lt;/i&gt; themes.&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Settings → Language&lt;/b&gt; — choose &lt;i&gt;English&lt;/i&gt; or &lt;i&gt;Українська&lt;/i&gt;.&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Traffic Player&lt;/b&gt; — switch to the generator / player view.&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Packet Constructor&lt;/b&gt; — switch to the packet-building view.&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Help&lt;/b&gt; — opens this window.&lt;/li&gt;
             &lt;/ul&gt;

             &lt;p&gt;The central area switches between two pages:&lt;br/&gt;
             &lt;b&gt;Generator Page&lt;/b&gt; (traffic playback and random generation) and
             &lt;b&gt;Constructor Page&lt;/b&gt; (manual packet building).&lt;/p&gt;

             &lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>

       <!-- Page 1: Random Generator -->
       <widget class="QWidget" name="pageRandGen">
        <layout class="QVBoxLayout">
         <item>
          <widget class="QLabel" name="labelRGTitle">
           <property name="text"><string>&lt;h2&gt;Random Traffic Generator&lt;/h2&gt;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QTextBrowser" name="browserRG">
           <property name="html">
            <string>&lt;!DOCTYPE html&gt;
             &lt;html&gt;
             &lt;body style="font-family: 'Times New Roman', serif; font-size: 13px;"&gt;

             &lt;p&gt;The &lt;b&gt;Random Generator&lt;/b&gt; tab (inside the Generator Page) generates synthetic traffic
             using configurable statistical distributions. All packet fields are filled with random values
             constrained by the parameters you set.&lt;/p&gt;

             &lt;h3&gt;How to Start&lt;/h3&gt;
             &lt;ol&gt;
             &lt;li&gt;Navigate to &lt;b&gt;Traffic Player&lt;/b&gt; from the menu bar.&lt;/li&gt;
             &lt;li&gt;Select the &lt;b&gt;Random Generator&lt;/b&gt; tab on the right panel.&lt;/li&gt;
             &lt;li&gt;Configure the desired distribution parameters in the &lt;b&gt;GeneratorParams&lt;/b&gt; sub-widget
             (packet size range, inter-packet delay law, traffic intensity, etc.).&lt;/li&gt;
             &lt;li&gt;Optionally set a &lt;b&gt;duration&lt;/b&gt; using the days spinner and the
             &lt;code&gt;HH:mm:ss&lt;/code&gt; time editor at the bottom. Leaving them at zero runs
             generation indefinitely until you press Stop.&lt;/li&gt;
             &lt;li&gt;Press the &lt;b&gt;▶ Start&lt;/b&gt; button.&lt;/li&gt;
             &lt;/ol&gt;

             &lt;h3&gt;Playback Controls&lt;/h3&gt;
             &lt;table border="1" cellpadding="4" cellspacing="0"&gt;
             &lt;tr&gt;&lt;th&gt;Button&lt;/th&gt;&lt;th&gt;Action&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;▶ Start&lt;/td&gt;&lt;td&gt;Begin generating and transmitting packets.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;■ Stop&lt;/td&gt;&lt;td&gt;Halt generation immediately. Statistics are preserved.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;⏸ Pause / Resume&lt;/td&gt;&lt;td&gt;Temporarily suspend or resume generation.&lt;/td&gt;&lt;/tr&gt;
             &lt;/table&gt;

             &lt;h3&gt;Duration Controls&lt;/h3&gt;
             &lt;ul&gt;
             &lt;li&gt;&lt;b&gt;Days spinner&lt;/b&gt; — integer number of days (0 = not used as limit).&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Time edit (HH:mm:ss)&lt;/b&gt; — hours, minutes and seconds portion of the limit.&lt;/li&gt;
             &lt;/ul&gt;
             &lt;p&gt;Both controls together define the total generation time limit.
             When the limit is reached the generator stops automatically.&lt;/p&gt;

             &lt;h3&gt;Random Law Parameters (GeneratorParams)&lt;/h3&gt;
             &lt;p&gt;Depending on your build, the GeneratorParams widget exposes fields such as:&lt;/p&gt;
             &lt;ul&gt;
             &lt;li&gt;&lt;b&gt;Distribution type&lt;/b&gt; — e.g. Uniform, Exponential, Poisson, Normal.&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Mean / Lambda&lt;/b&gt; — primary parameter of the chosen distribution (decimal, &amp;gt; 0).&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Min / Max packet size&lt;/b&gt; — byte range for generated payload (integers, e.g. 64–1500).&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Bandwidth limit&lt;/b&gt; — maximum throughput in Mbit/s (0 = unlimited).&lt;/li&gt;
             &lt;/ul&gt;
             &lt;p&gt;Refer to the tooltip on each field for the accepted range.&lt;/p&gt;

             &lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>

       <!-- Page 2: PCAP Player -->
       <widget class="QWidget" name="pagePcapPlayer">
        <layout class="QVBoxLayout">
         <item>
          <widget class="QLabel" name="labelPPTitle">
           <property name="text"><string>&lt;h2&gt;PCAP Player&lt;/h2&gt;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QTextBrowser" name="browserPP">
           <property name="html">
            <string>&lt;!DOCTYPE html&gt;
             &lt;html&gt;
             &lt;body style="font-family: 'Times New Roman', serif; font-size: 13px;"&gt;

             &lt;p&gt;The &lt;b&gt;PCAP Player&lt;/b&gt; tab replays an existing &lt;code&gt;.pcap&lt;/code&gt; capture file over
             the network, preserving original inter-packet timing (or at a custom speed multiplier).&lt;/p&gt;

             &lt;h3&gt;How to Load and Play a PCAP File&lt;/h3&gt;
             &lt;ol&gt;
             &lt;li&gt;Navigate to &lt;b&gt;Traffic Player&lt;/b&gt; from the menu bar.&lt;/li&gt;
             &lt;li&gt;Select the &lt;b&gt;PCAP Player&lt;/b&gt; tab on the right panel.&lt;/li&gt;
             &lt;li&gt;In the GeneratorPlayer sub-widget, click &lt;b&gt;Open File&lt;/b&gt; (or use &lt;b&gt;File → Open&lt;/b&gt;
             from the menu bar) and choose a &lt;code&gt;.pcap&lt;/code&gt; or &lt;code&gt;.pcapng&lt;/code&gt; file.&lt;/li&gt;
             &lt;li&gt;The file is parsed; the packet list appears in the view.&lt;/li&gt;
             &lt;li&gt;Optionally configure the playback speed multiplier and loop settings.&lt;/li&gt;
             &lt;li&gt;Optionally set a duration limit with the days-spinner and time-edit at the bottom.&lt;/li&gt;
             &lt;li&gt;Press &lt;b&gt;▶ Start&lt;/b&gt; to begin replay.&lt;/li&gt;
             &lt;/ol&gt;

             &lt;h3&gt;Playback Controls&lt;/h3&gt;
             &lt;table border="1" cellpadding="4" cellspacing="0"&gt;
             &lt;tr&gt;&lt;th&gt;Button&lt;/th&gt;&lt;th&gt;Action&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;▶ Start&lt;/td&gt;&lt;td&gt;Start or restart replay from the beginning.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;■ Stop&lt;/td&gt;&lt;td&gt;Stop replay. The position resets to the first packet.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;⏸ Pause / Resume&lt;/td&gt;&lt;td&gt;Freeze at the current packet; resume from that point.&lt;/td&gt;&lt;/tr&gt;
             &lt;/table&gt;

             &lt;h3&gt;Notes on PCAP Files&lt;/h3&gt;
             &lt;ul&gt;
             &lt;li&gt;Supported formats: &lt;code&gt;pcap&lt;/code&gt; (libpcap) and &lt;code&gt;pcapng&lt;/code&gt;.&lt;/li&gt;
             &lt;li&gt;The player reads timestamps from the capture and reproduces the original
             inter-packet gaps unless a speed multiplier is set.&lt;/li&gt;
             &lt;li&gt;You can also create your own &lt;code&gt;.pcap&lt;/code&gt; files with the
             &lt;b&gt;Packet Constructor&lt;/b&gt; and then load them here for replay.&lt;/li&gt;
             &lt;/ul&gt;

             &lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>

       <!-- Page 3: Packet Constructor Overview -->
       <widget class="QWidget" name="pageConstructor">
        <layout class="QVBoxLayout">
         <item>
          <widget class="QLabel" name="labelCTitle">
           <property name="text"><string>&lt;h2&gt;Packet Constructor — Overview&lt;/h2&gt;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QTextBrowser" name="browserC">
           <property name="html">
            <string>&lt;!DOCTYPE html&gt;
             &lt;html&gt;
             &lt;body style="font-family: 'Times New Roman', serif; font-size: 13px;"&gt;

             &lt;p&gt;The &lt;b&gt;Packet Constructor&lt;/b&gt; lets you hand-craft individual network packets and save
             them into a &lt;code&gt;.pcap&lt;/code&gt; file for later replay or analysis.&lt;/p&gt;

             &lt;h3&gt;Layout&lt;/h3&gt;
             &lt;ul&gt;
             &lt;li&gt;&lt;b&gt;Top-left — Packet Table&lt;/b&gt;: lists all packets added to the current PCAP file.
             Selecting a row loads that packet's fields into the editor.&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Bottom-left — Packet Detail Tree&lt;/b&gt;: shows a decoded breakdown (Field / Value)
             of the selected packet, similar to Wireshark's detail pane.&lt;/li&gt;
             &lt;li&gt;&lt;b&gt;Right panel — Tab editor&lt;/b&gt;: four tabs for editing each protocol layer:
             &lt;i&gt;Ethernet&lt;/i&gt;, &lt;i&gt;Network Protocol&lt;/i&gt;, &lt;i&gt;Transfer Protocol&lt;/i&gt;, &lt;i&gt;Data&lt;/i&gt;.&lt;/li&gt;
             &lt;/ul&gt;

             &lt;h3&gt;Workflow&lt;/h3&gt;
             &lt;ol&gt;
             &lt;li&gt;Fill in fields across the four tabs (see the following help sections).&lt;/li&gt;
             &lt;li&gt;Click &lt;b&gt;Add Packet&lt;/b&gt; to append the packet to the list.&lt;/li&gt;
             &lt;li&gt;Select a row and click &lt;b&gt;Edit&lt;/b&gt; to modify an existing packet, then &lt;b&gt;Save&lt;/b&gt;.&lt;/li&gt;
             &lt;li&gt;Use &lt;b&gt;Delete&lt;/b&gt; to remove a selected packet, or &lt;b&gt;Clear&lt;/b&gt; to remove all.&lt;/li&gt;
             &lt;li&gt;Click &lt;b&gt;Save to File&lt;/b&gt; to write the packet list to a &lt;code&gt;.pcap&lt;/code&gt; file.&lt;/li&gt;
             &lt;li&gt;Click &lt;b&gt;Open File&lt;/b&gt; to load a previously saved &lt;code&gt;.pcap&lt;/code&gt; for editing.&lt;/li&gt;
             &lt;li&gt;Click &lt;b&gt;Cancel&lt;/b&gt; to discard changes to the currently edited packet.&lt;/li&gt;
             &lt;/ol&gt;

             &lt;h3&gt;Fields marked "Auto"&lt;/h3&gt;
             &lt;p&gt;Many fields have an &lt;b&gt;Auto&lt;/b&gt; checkbox next to them. When checked (default) the
             application computes the correct value automatically (e.g. checksum, total length,
             version). Uncheck &lt;b&gt;Auto&lt;/b&gt; to enter a custom raw value.&lt;/p&gt;

             &lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>

       <!-- Page 4: Ethernet Tab -->
       <widget class="QWidget" name="pageEthernet">
        <layout class="QVBoxLayout">
         <item>
          <widget class="QLabel" name="labelETHTitle">
           <property name="text"><string>&lt;h2&gt;Constructor — Ethernet Tab&lt;/h2&gt;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QTextBrowser" name="browserETH">
           <property name="html">
            <string>&lt;!DOCTYPE html&gt;
             &lt;html&gt;
             &lt;body style="font-family: 'Times New Roman', serif; font-size: 13px;"&gt;

             &lt;p&gt;The &lt;b&gt;Ethernet&lt;/b&gt; tab configures the Layer-2 (Data Link) header of the packet.&lt;/p&gt;

             &lt;table border="1" cellpadding="5" cellspacing="0" width="100%"&gt;
             &lt;tr style="background:#ddd;"&gt;
             &lt;th&gt;Field&lt;/th&gt;&lt;th&gt;Format / Allowed Values&lt;/th&gt;&lt;th&gt;Example&lt;/th&gt;&lt;th&gt;Notes&lt;/th&gt;
             &lt;/tr&gt;
             &lt;tr&gt;
             &lt;td&gt;&lt;b&gt;Source MAC&lt;/b&gt;&lt;/td&gt;
             &lt;td&gt;Six hex octets separated by colons or dashes.&lt;br/&gt;
             Pattern: &lt;code&gt;XX:XX:XX:XX:XX:XX&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;AA:BB:CC:DD:EE:FF&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;Sender hardware address.&lt;/td&gt;
             &lt;/tr&gt;
             &lt;tr&gt;
             &lt;td&gt;&lt;b&gt;Destination MAC&lt;/b&gt;&lt;/td&gt;
             &lt;td&gt;Same as Source MAC.&lt;br/&gt;
             Use &lt;code&gt;FF:FF:FF:FF:FF:FF&lt;/code&gt; for broadcast.&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;00:11:22:33:44:55&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;Receiver hardware address.&lt;/td&gt;
             &lt;/tr&gt;
             &lt;tr&gt;
             &lt;td&gt;&lt;b&gt;Frame Check Sequence (FCS)&lt;/b&gt;&lt;/td&gt;
             &lt;td&gt;4-byte hex value: &lt;code&gt;0x00000000&lt;/code&gt; – &lt;code&gt;0xFFFFFFFF&lt;/code&gt;&lt;br/&gt;
             Or enter as 8 hex digits without prefix.&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;1A2B3C4D&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;CRC-32 integrity trailer. Leave blank to auto-calculate.&lt;/td&gt;
             &lt;/tr&gt;
             &lt;tr&gt;
             &lt;td&gt;&lt;b&gt;Time (for PCAP Info)&lt;/b&gt;&lt;/td&gt;
             &lt;td&gt;Date-time picker: &lt;code&gt;dd.MM.yyyy HH:mm:ss&lt;/code&gt;&lt;br/&gt;
             Nanoseconds: up to 6 digits (&lt;code&gt;000000&lt;/code&gt;–&lt;code&gt;999999&lt;/code&gt;)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;15.05.2024 13:45:00&lt;/code&gt; / &lt;code&gt;123456&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;Timestamp written into the PCAP packet header.
             Enable &lt;b&gt;Current&lt;/b&gt; checkbox to use the system clock automatically.
             When &lt;b&gt;Current&lt;/b&gt; is checked, the date-time picker and nanosecond
             field are disabled.&lt;/td&gt;
             &lt;/tr&gt;
             &lt;/table&gt;

             &lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>

       <!-- Page 5: Network Protocol Tab -->
       <widget class="QWidget" name="pageNetworkProto">
        <layout class="QVBoxLayout">
         <item>
          <widget class="QLabel" name="labelNPTitle">
           <property name="text"><string>&lt;h2&gt;Constructor — Network Protocol Tab&lt;/h2&gt;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QTextBrowser" name="browserNP">
           <property name="html">
            <string>&lt;!DOCTYPE html&gt;
             &lt;html&gt;
             &lt;body style="font-family: 'Times New Roman', serif; font-size: 13px;"&gt;

             &lt;p&gt;Select a Layer-3 protocol from the dropdown: &lt;b&gt;None&lt;/b&gt;, &lt;b&gt;ARP&lt;/b&gt;, &lt;b&gt;IPv4&lt;/b&gt;,
             &lt;b&gt;IPv6&lt;/b&gt;, or &lt;b&gt;Custom&lt;/b&gt; (raw hex). The panel below the dropdown changes accordingly.&lt;/p&gt;

             &lt;hr/&gt;
             &lt;h3&gt;ARP Fields&lt;/h3&gt;
             &lt;table border="1" cellpadding="4" cellspacing="0" width="100%"&gt;
             &lt;tr style="background:#ddd;"&gt;&lt;th&gt;Field&lt;/th&gt;&lt;th&gt;Format&lt;/th&gt;&lt;th&gt;Example&lt;/th&gt;&lt;th&gt;Notes&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Operation&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal integer: &lt;code&gt;1&lt;/code&gt; or &lt;code&gt;2&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;1&lt;/code&gt;&lt;/td&gt;&lt;td&gt;1 = ARP Request, 2 = ARP Reply&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Destination IP&lt;/b&gt;&lt;/td&gt;&lt;td&gt;IPv4 dotted decimal&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;192.168.1.1&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Target protocol address&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Destination MAC&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;XX:XX:XX:XX:XX:XX&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;00:00:00:00:00:00&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Target hardware address (all zeros for request)&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Source IP&lt;/b&gt;&lt;/td&gt;&lt;td&gt;IPv4 dotted decimal&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;192.168.1.100&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Sender protocol address&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Source MAC&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;XX:XX:XX:XX:XX:XX&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;AA:BB:CC:DD:EE:FF&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Sender hardware address&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Hardware Type&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal integer (16-bit)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;1&lt;/code&gt;&lt;/td&gt;&lt;td&gt;1 = Ethernet. &lt;b&gt;Auto&lt;/b&gt; sets this automatically.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Hardware Size&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal integer (8-bit, 0–255)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;6&lt;/code&gt;&lt;/td&gt;&lt;td&gt;MAC address length in bytes. &lt;b&gt;Auto&lt;/b&gt; = 6.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Protocol Type&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Hex EtherType (4 hex digits)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;0800&lt;/code&gt;&lt;/td&gt;&lt;td&gt;0800 = IPv4. &lt;b&gt;Auto&lt;/b&gt; derives from selected NP.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Protocol Size&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal integer (8-bit, 0–255)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;4&lt;/code&gt;&lt;/td&gt;&lt;td&gt;IP address length in bytes. &lt;b&gt;Auto&lt;/b&gt; = 4.&lt;/td&gt;&lt;/tr&gt;
             &lt;/table&gt;

             &lt;hr/&gt;
             &lt;h3&gt;IPv4 Fields&lt;/h3&gt;
             &lt;table border="1" cellpadding="4" cellspacing="0" width="100%"&gt;
             &lt;tr style="background:#ddd;"&gt;&lt;th&gt;Field&lt;/th&gt;&lt;th&gt;Format&lt;/th&gt;&lt;th&gt;Example&lt;/th&gt;&lt;th&gt;Notes&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Destination IP&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dotted decimal &lt;code&gt;A.B.C.D&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;10.0.0.1&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Destination host address&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Source IP&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dotted decimal &lt;code&gt;A.B.C.D&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;10.0.0.2&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Source host address&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Time To Live (TTL)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal integer 0–255&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;64&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Max router hops before discarding&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Flags&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Hex or decimal (3-bit field, 0–7)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;2&lt;/code&gt; (DF set)&lt;/td&gt;&lt;td&gt;Bit 1 = Don't Fragment (DF); Bit 0 = More Fragments (MF)&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Frag Offset&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal integer 0–8191&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;0&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Fragment offset in 8-byte units&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;DSCP Ecn&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–255 (8-bit TOS/DS byte)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;0&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Upper 6 bits = DSCP, lower 2 bits = ECN&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Version&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Integer (4-bit, 0–15)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;4&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; always writes 4 for IPv4. Uncheck to set custom.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Internet Header Length (IHL)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Integer 5–15 (32-bit words)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;5&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; computes from options. 5 = no options (20 bytes).&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Checksum&lt;/b&gt;&lt;/td&gt;&lt;td&gt;4 hex digits (16-bit)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;0000&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; calculates CRC over the IP header.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Total Length&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal integer 20–65535 (bytes)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;60&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; = header + payload length.&lt;/td&gt;&lt;/tr&gt;
             &lt;/table&gt;

             &lt;hr/&gt;
             &lt;h3&gt;IPv6 Fields&lt;/h3&gt;
             &lt;table border="1" cellpadding="4" cellspacing="0" width="100%"&gt;
             &lt;tr style="background:#ddd;"&gt;&lt;th&gt;Field&lt;/th&gt;&lt;th&gt;Format&lt;/th&gt;&lt;th&gt;Example&lt;/th&gt;&lt;th&gt;Notes&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Destination IP&lt;/b&gt;&lt;/td&gt;&lt;td&gt;IPv6 colon-hex notation&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;2001:db8::1&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Supports compressed form (::)&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Source IP&lt;/b&gt;&lt;/td&gt;&lt;td&gt;IPv6 colon-hex notation&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;fe80::1&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Supports link-local, global unicast, multicast&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Hop Limit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal integer 0–255&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;64&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Equivalent to IPv4 TTL&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Next Header&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal protocol number 0–255&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;6&lt;/code&gt; (TCP), &lt;code&gt;17&lt;/code&gt; (UDP)&lt;/td&gt;&lt;td&gt;Identifies the payload protocol&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Flow Label&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Hex or decimal 0–1048575 (20-bit)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;0&lt;/code&gt;&lt;/td&gt;&lt;td&gt;QoS flow identifier&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Traffic Class&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–255 (8-bit)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;0&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Upper 6 bits DSCP, lower 2 bits ECN&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Version&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Integer (4-bit)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;6&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; always writes 6 for IPv6.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Payload Length&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–65535 (bytes)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;40&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; = length of everything after the IPv6 fixed header.&lt;/td&gt;&lt;/tr&gt;
             &lt;/table&gt;

             &lt;hr/&gt;
             &lt;h3&gt;Custom Network Protocol&lt;/h3&gt;
             &lt;p&gt;Select &lt;b&gt;Custom&lt;/b&gt; to enter raw Layer-3 bytes in the text area as space-separated
             hex octets, e.g.: &lt;code&gt;08 00 45 00 00 28 ...&lt;/code&gt;&lt;/p&gt;

             &lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>

       <!-- Page 6: Transfer Protocol Tab -->
       <widget class="QWidget" name="pageTransferProto">
        <layout class="QVBoxLayout">
         <item>
          <widget class="QLabel" name="labelTPTitle">
           <property name="text"><string>&lt;h2&gt;Constructor — Transfer Protocol Tab&lt;/h2&gt;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QTextBrowser" name="browserTP">
           <property name="html">
            <string>&lt;!DOCTYPE html&gt;
             &lt;html&gt;
             &lt;body style="font-family: 'Times New Roman', serif; font-size: 13px;"&gt;

             &lt;p&gt;Select a Layer-4 protocol: &lt;b&gt;None&lt;/b&gt;, &lt;b&gt;TCP&lt;/b&gt;, &lt;b&gt;UDP&lt;/b&gt;, &lt;b&gt;ICMP&lt;/b&gt;,
             or &lt;b&gt;Custom&lt;/b&gt; (raw hex).&lt;/p&gt;

             &lt;hr/&gt;
             &lt;h3&gt;TCP Fields&lt;/h3&gt;
             &lt;table border="1" cellpadding="4" cellspacing="0" width="100%"&gt;
             &lt;tr style="background:#ddd;"&gt;&lt;th&gt;Field&lt;/th&gt;&lt;th&gt;Format&lt;/th&gt;&lt;th&gt;Example&lt;/th&gt;&lt;th&gt;Notes&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Destination Port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–65535&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;80&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Target service port&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Source Port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–65535&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;49152&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Ephemeral ports: 49152–65535&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Sequence Number&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–4294967295 (32-bit)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;1000&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Byte sequence counter&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Acknowledgment Number&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–4294967295 (32-bit)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;0&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Valid only when ACK flag is set&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Flags&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Individual checkboxes &lt;i&gt;or&lt;/i&gt; Custom hex byte&lt;/td&gt;
             &lt;td&gt;☑ SYN&lt;/td&gt;&lt;td&gt;
             Available flags: &lt;b&gt;Accurate ECN&lt;/b&gt;, &lt;b&gt;ECN-Echo&lt;/b&gt;, &lt;b&gt;Urgent&lt;/b&gt;,
             &lt;b&gt;ACK&lt;/b&gt;, &lt;b&gt;Push&lt;/b&gt;, &lt;b&gt;Reset&lt;/b&gt;, &lt;b&gt;SYN&lt;/b&gt;, &lt;b&gt;FIN&lt;/b&gt;.&lt;br/&gt;
             Enable &lt;b&gt;Custom&lt;/b&gt; to type a raw 8-bit flag byte in hex (e.g. &lt;code&gt;02&lt;/code&gt; = SYN only).
             &lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Window Size&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–65535 (bytes)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;8192&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Receive buffer size advertised to peer&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Urgent Pointer&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–65535&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;0&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Meaningful only when URG flag is set&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Options List&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Space-separated hex bytes&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;02 04 05 B4&lt;/code&gt;&lt;/td&gt;&lt;td&gt;TCP options (MSS, SACK, timestamps, etc.)&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Data Offset&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Integer 5–15 (32-bit words)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;5&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; computes from options length.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Checksum&lt;/b&gt;&lt;/td&gt;&lt;td&gt;4 hex digits (16-bit)&lt;/td&gt;
             &lt;td&gt;&lt;code&gt;0000&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; calculates over pseudo-header + segment.&lt;/td&gt;&lt;/tr&gt;
             &lt;/table&gt;

             &lt;hr/&gt;
             &lt;h3&gt;UDP Fields&lt;/h3&gt;
             &lt;table border="1" cellpadding="4" cellspacing="0" width="100%"&gt;
             &lt;tr style="background:#ddd;"&gt;&lt;th&gt;Field&lt;/th&gt;&lt;th&gt;Format&lt;/th&gt;&lt;th&gt;Example&lt;/th&gt;&lt;th&gt;Notes&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Destination Port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–65535&lt;/td&gt;&lt;td&gt;&lt;code&gt;53&lt;/code&gt;&lt;/td&gt;&lt;td&gt;DNS example&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Source Port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–65535&lt;/td&gt;&lt;td&gt;&lt;code&gt;5000&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Checksum&lt;/b&gt;&lt;/td&gt;&lt;td&gt;4 hex digits (16-bit)&lt;/td&gt;&lt;td&gt;&lt;code&gt;0000&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; calculates; set to &lt;code&gt;0000&lt;/code&gt; to disable (IPv4 optional).&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Total Length&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 8–65535 (bytes)&lt;/td&gt;&lt;td&gt;&lt;code&gt;20&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; = 8 (UDP header) + data length.&lt;/td&gt;&lt;/tr&gt;
             &lt;/table&gt;

             &lt;hr/&gt;
             &lt;h3&gt;ICMP Fields&lt;/h3&gt;
             &lt;table border="1" cellpadding="4" cellspacing="0" width="100%"&gt;
             &lt;tr style="background:#ddd;"&gt;&lt;th&gt;Field&lt;/th&gt;&lt;th&gt;Format&lt;/th&gt;&lt;th&gt;Example&lt;/th&gt;&lt;th&gt;Notes&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Type&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–255&lt;/td&gt;&lt;td&gt;&lt;code&gt;8&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;8 = Echo Request; 0 = Echo Reply; 3 = Dest. Unreachable&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Code&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–255&lt;/td&gt;&lt;td&gt;&lt;code&gt;0&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;Sub-type; for Echo Request/Reply always 0&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Identifier&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–65535 (16-bit)&lt;/td&gt;&lt;td&gt;&lt;code&gt;1&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;Session identifier; matches request to reply&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Sequence&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Decimal 0–65535 (16-bit)&lt;/td&gt;&lt;td&gt;&lt;code&gt;1&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;Incremented per packet in a ping session&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Payload&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Space-separated hex bytes&lt;/td&gt;&lt;td&gt;&lt;code&gt;61 62 63&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; fills with a standard pattern ("abcd...").&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Checksum&lt;/b&gt;&lt;/td&gt;&lt;td&gt;4 hex digits (16-bit)&lt;/td&gt;&lt;td&gt;&lt;code&gt;0000&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;&lt;b&gt;Auto&lt;/b&gt; calculates over the entire ICMP message.&lt;/td&gt;&lt;/tr&gt;
             &lt;/table&gt;

             &lt;hr/&gt;
             &lt;h3&gt;Custom Transfer Protocol&lt;/h3&gt;
             &lt;p&gt;Select &lt;b&gt;Custom&lt;/b&gt; to type raw Layer-4 bytes in the text area as space-separated
             hex octets, e.g.: &lt;code&gt;00 50 C0 00 00 00 00 01 ...&lt;/code&gt;&lt;/p&gt;

             &lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>

       <!-- Page 7: Data Tab -->
       <widget class="QWidget" name="pageData">
        <layout class="QVBoxLayout">
         <item>
          <widget class="QLabel" name="labelDTTitle">
           <property name="text"><string>&lt;h2&gt;Constructor — Data Tab&lt;/h2&gt;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QTextBrowser" name="browserDT">
           <property name="html">
            <string>&lt;!DOCTYPE html&gt;
             &lt;html&gt;
             &lt;body style="font-family: 'Times New Roman', serif; font-size: 13px;"&gt;

             &lt;p&gt;The &lt;b&gt;Data&lt;/b&gt; tab defines the application-layer payload carried inside the packet.
             It offers two synchronized editors:&lt;/p&gt;

             &lt;table border="1" cellpadding="5" cellspacing="0" width="100%"&gt;
             &lt;tr style="background:#ddd;"&gt;&lt;th&gt;Editor&lt;/th&gt;&lt;th&gt;Format&lt;/th&gt;&lt;th&gt;Notes&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;
             &lt;td&gt;&lt;b&gt;Hex&lt;/b&gt;&lt;/td&gt;
             &lt;td&gt;Space-separated hex octets, e.g. &lt;code&gt;48 65 6C 6C 6F&lt;/code&gt;&lt;/td&gt;
             &lt;td&gt;Enter raw bytes directly. Each octet is two hex digits (00–FF).
             Non-printable bytes must be entered here.&lt;/td&gt;
             &lt;/tr&gt;
             &lt;tr&gt;
             &lt;td&gt;&lt;b&gt;ASCII&lt;/b&gt;&lt;/td&gt;
             &lt;td&gt;Plain text (UTF-8 / ASCII)&lt;/td&gt;
             &lt;td&gt;Type readable text; it is automatically converted to hex on the left.
             Non-ASCII characters are replaced with &lt;code&gt;.&lt;/code&gt; in the display.&lt;/td&gt;
             &lt;/tr&gt;
             &lt;/table&gt;

             &lt;p&gt;Both editors stay in sync — editing one updates the other automatically.&lt;/p&gt;

             &lt;h3&gt;Tips&lt;/h3&gt;
             &lt;ul&gt;
             &lt;li&gt;Leave both editors empty for a packet with no payload (e.g. a pure TCP SYN).&lt;/li&gt;
             &lt;li&gt;Paste hex dumps from Wireshark directly into the Hex editor.&lt;/li&gt;
             &lt;li&gt;Maximum payload size is limited by the selected network protocol's MTU
             (typically 1460 bytes for TCP/IPv4 over Ethernet).&lt;/li&gt;
             &lt;/ul&gt;

             &lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>

       <!-- Page 8: Statistics Window -->
       <widget class="QWidget" name="pageStatistics">
        <layout class="QVBoxLayout">
         <item>
          <widget class="QLabel" name="labelSTATTitle">
           <property name="text"><string>&lt;h2&gt;Statistics Window&lt;/h2&gt;</string></property>
          </widget>
         </item>
         <item>
          <widget class="QTextBrowser" name="browserSTAT">
           <property name="html">
            <string>&lt;!DOCTYPE html&gt;
             &lt;html&gt;
             &lt;body style="font-family: 'Times New Roman', serif; font-size: 13px;"&gt;

             &lt;p&gt;The &lt;b&gt;Statistics Window&lt;/b&gt; is embedded in the left portion of the Generator Page.
             It displays real-time transmission metrics and a live throughput chart.&lt;/p&gt;

             &lt;h3&gt;Metrics&lt;/h3&gt;
             &lt;table border="1" cellpadding="5" cellspacing="0" width="100%"&gt;
             &lt;tr style="background:#ddd;"&gt;&lt;th&gt;Metric&lt;/th&gt;&lt;th&gt;Unit&lt;/th&gt;&lt;th&gt;Description&lt;/th&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Speed (B/s)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bytes per second&lt;/td&gt;
             &lt;td&gt;Current transmission throughput in bytes.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Speed (bit/s)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bits per second&lt;/td&gt;
             &lt;td&gt;Same throughput expressed in bits (B/s × 8).&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Packets/s&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Packets per second&lt;/td&gt;
             &lt;td&gt;Number of packets sent in the last measurement interval.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Total Packets&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Count&lt;/td&gt;
             &lt;td&gt;Cumulative packets sent since the last Reset or Start.&lt;/td&gt;&lt;/tr&gt;
             &lt;tr&gt;&lt;td&gt;&lt;b&gt;Total Data&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bytes (auto-scaled to KB/MB)&lt;/td&gt;
             &lt;td&gt;Cumulative bytes transmitted since the last Reset or Start.&lt;/td&gt;&lt;/tr&gt;
             &lt;/table&gt;

             &lt;h3&gt;Chart&lt;/h3&gt;
             &lt;p&gt;The chart at the top of the Statistics Window plots throughput over time.
             The X-axis is time and the Y-axis is transfer rate. The chart scrolls
             automatically as data arrives.&lt;/p&gt;

             &lt;h3&gt;Reset Button&lt;/h3&gt;
             &lt;p&gt;Clicking &lt;b&gt;Reset&lt;/b&gt; clears all counters and the chart without stopping
             active generation. Use it to start a fresh measurement mid-session.&lt;/p&gt;

             &lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>

      </widget>
     </item>

     <!-- Bottom close button -->
     <item>
      <layout class="QHBoxLayout" name="bottomLayout">
       <item>
        <spacer>
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
        </spacer>
       </item>
       <item>
        <widget class="QPushButton" name="closeBtn">
         <property name="text"><string>Close</string></property>
         <property name="minimumSize">
          <size><width>90</width><height>30</height></size>
         </property>
        </widget>
       </item>
      </layout>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>